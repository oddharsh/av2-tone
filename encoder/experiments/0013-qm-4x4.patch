+  // av2-tone patch 0013 (experimental syntax): the optional 4x4 matrices.
+  qm_val_t **m4 = qm_list[qm_pos].quantizer_matrix[QM_FUND_4X4];
+  const bool qm_4x4_present = m4[0][0] != 0;
+  avm_wb_write_bit(wb, qm_4x4_present);
+  for (int c = 0; qm_4x4_present && c < num_planes; c++) {
+    if (c > 0) {
+      const bool copy = qm_matrices_are_equal(m4[c - 1], m4[c], 4, 4);
+      avm_wb_write_bit(wb, copy);
+      if (copy) continue;
+    }
+    const SCAN_ORDER *s = get_scan(TX_4X4, DCT_DCT);
+    int16_t prev = 32;
+    for (int i = 0; i < 16; i++) {
+      const int16_t coeff = m4[c][s->scan[i]];
+      int16_t delta = coeff - prev;
+      if (delta < -128) {
+        delta += 256;
+      } else if (delta > 127) {
+        delta -= 256;
+      }
+      avm_wb_write_svlc(wb, delta);
+      prev = coeff;
+    }
+  }
+
   size = wb->bit_offset - size;
   return size;
 }

   }
+
+  // av2-tone patch 0013 (experimental syntax): an optional 4x4 matrix per
+  // plane, coded as deltas in scan order. Without one, 4x4 transforms take
+  // the 8x8 matrix downsampled.
+  const bool qm_4x4_present = avm_rb_read_bit(rb);
+  for (int c = 0; c < num_planes; c++) {
+    qm_val_t *mat = qmset->quantizer_matrix[QM_FUND_4X4][c];
+    if (!qm_4x4_present) {
+      mat[0] = 0;
+      continue;
+    }
+    if (c > 0 && avm_rb_read_bit(rb)) {
+      memcpy(mat, qmset->quantizer_matrix[QM_FUND_4X4][c - 1],
+             16 * sizeof(qm_val_t));
+      continue;
+    }
+    const SCAN_ORDER *s = get_scan(TX_4X4, DCT_DCT);
+    qm_val_t prev = 32;
+    for (int i = 0; i < 16; i++) {
+      const int32_t delta = avm_rb_read_svlc(rb);
+      if (delta < -128 || delta > 127) {
+        avm_internal_error(&pbi->common.error, AVM_CODEC_CORRUPT_FRAME,
+                           "Invalid matrix_coef_delta: %d", delta);
+      }
+      prev = (prev + delta + 256) % 256;
+      if (prev < 5) {
+        avm_internal_error(&pbi->common.error, AVM_CODEC_CORRUPT_FRAME,
+                           "Invalid 4x4 matrix coefficient: %d", prev);
+      }
+      mat[s->scan[i]] = prev;
+    }
+  }

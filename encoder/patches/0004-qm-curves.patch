+// libaom's still-image QM curves, thresholds moved to AV2's 10-bit qindex by
+// matching AC step size (AV1 qindex in the comment). Decreasing in qindex:
+// a finer quantizer gets a flatter matrix.
+static int qm_q10(int qindex, avm_bit_depth_t bd) {
+  // the same step sits 48 qindex higher per two bits of depth
+  return bd == AVM_BITS_8 ? qindex + 2 * MAXQ_OFFSET
+         : bd == AVM_BITS_10 ? qindex
+                             : qindex - 2 * MAXQ_OFFSET;
+}
+static int qm_curve_level(int q10, const int *thr, int n, int top) {
+  int level = top;
+  for (int i = 0; i < n && q10 > thr[i]; i++) level--;
+  return level;
+}
+// aom_get_qmlevel_allintra: av1 40 100 160 200 220 240, levels 10..4
+static const int qm_thr_allintra[] = { 121, 156, 191, 217, 230, 243 };
+// aom_get_qmlevel_luma_ssimulacra2: av1 40 60 90 120 130 140 160 200, 10..2
+static const int qm_thr_luma_s2[] = { 121, 136, 150, 167, 173, 179, 191, 217 };
+// aom_get_qmlevel_444_chroma: av1 12 24 32 36 44 48 56 88, levels 10..2
+static const int qm_thr_chroma444[] = { 73, 100, 112, 116, 124, 128, 133, 150 };
+
+static int qm_level_for(int qindex, int curve, int min_qmlevel,
+                        int max_qmlevel, avm_bit_depth_t bd) {
+  const int q10 = qm_q10(qindex, bd);
+  switch (curve) {
+    case 1: return qm_curve_level(q10, qm_thr_allintra, 6, 10);
+    case 2: return qm_curve_level(q10, qm_thr_luma_s2, 8, 10);
+    case 3: return qm_curve_level(q10, qm_thr_chroma444, 8, 10);
+    default: return avm_get_qmlevel(qindex, min_qmlevel, max_qmlevel, bd);
+  }
+}

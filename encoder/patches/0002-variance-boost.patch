diff --avm
--- a/av2/encoder/aq_variance.c	2026-09-27 00:29:57
+++ b/av2/encoder/aq_variance.c	2026-09-27 09:48:40
@@ -196,6 +196,59 @@
 
 #define DEFAULT_E_MIDPOINT 10.0
 
+static int vb_cmp_uint(const void *a, const void *b) {
+  const unsigned int x = *(const unsigned int *)a;
+  const unsigned int y = *(const unsigned int *)b;
+  return (x > y) - (x < y);
+}
+
+// Variance Boost: the qindex this superblock should use. The variance kernels
+// already return 8-bit-scale values for 10/12-bit input (highbd_10_variance
+// shifts the sum of squares down), so no bit-depth normalization is applied.
+int av2_get_sbq_variance_boost(const AV2_COMP *cpi, MACROBLOCK *x,
+                               BLOCK_SIZE sb_size) {
+  const AV2_COMMON *const cm = &cpi->common;
+  const MACROBLOCKD *const xd = &x->e_mbd;
+  const int base_qindex = cm->quant_params.base_qindex;
+  if (base_qindex <= 0) return base_qindex;
+  const QuantizationCfg *const q_cfg = &cpi->oxcf.q_cfg;
+  const int right_overflow =
+      (xd->mb_to_right_edge < 0) ? ((-xd->mb_to_right_edge) >> 3) : 0;
+  const int bottom_overflow =
+      (xd->mb_to_bottom_edge < 0) ? ((-xd->mb_to_bottom_edge) >> 3) : 0;
+  const int bw = MI_SIZE * mi_size_wide[sb_size] - right_overflow;
+  const int bh = MI_SIZE * mi_size_high[sb_size] - bottom_overflow;
+  // 256x256 is the largest superblock: 32x32 = 1024 8x8 blocks
+  unsigned int vars[1024];
+  int n = 0;
+  for (int i = 0; i + 8 <= bh; i += 8) {
+    for (int j = 0; j + 8 <= bw; j += 8) {
+      unsigned int sse;
+      const unsigned int v = cpi->fn_ptr[BLOCK_8X8].vf(
+          x->plane[0].src.buf + i * x->plane[0].src.stride + j,
+          x->plane[0].src.stride, av2_highbd_all_zeros, 0, &sse);
+      vars[n++] = v / 64;
+    }
+  }
+  if (n == 0) return base_qindex;
+  qsort(vars, n, sizeof(vars[0]), vb_cmp_uint);
+  // the octile and its two neighbours, weighted 1:2:1 (libaom's combination)
+  const int step = AVMMAX(1, n / 8);
+  const int mid = clamp(q_cfg->vb_octile * n / 8 - 1, 0, n - 1);
+  const int lo = AVMMAX(0, mid - step), hi = AVMMIN(n - 1, mid + step);
+  unsigned int var = (vars[lo] + 2 * vars[mid] + vars[hi] + 2) / 4;
+  if (var == 0) var = 1;
+  const double strength = q_cfg->vb_strength / 10.0;
+  double ratio = 0.15 * strength * (10.0 - log2((double)var)) + 1.0;
+  ratio = fclamp(ratio, 1.0, 8.0);
+  if (ratio <= 1.0) return base_qindex;
+  const avm_bit_depth_t bd = cm->seq_params.bit_depth;
+  const double target_q = av2_convert_qindex_to_q(base_qindex, bd) / ratio;
+  int target = av2_find_qindex(target_q, bd, MINQ, base_qindex);
+  target = AVMMAX(target, base_qindex - q_cfg->vb_max_boost);
+  return AVMMAX(target, 1);
+}

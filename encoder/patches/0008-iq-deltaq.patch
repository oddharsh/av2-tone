+// A step ratio as an AV2 qindex delta, inside the 6-bit frame delta_q syntax.
+static int iq_ratio_to_delta(double ratio) {
+  return clamp((int)lround(24.0 * log2(ratio)), -63, 63);
+}
+
+static void av2_iq_frame_delta_q(const AV2_COMMON *const cm,
+                                 CommonQuantParams *const quant_params) {
+  const int q = quant_params->base_qindex;
+  // lossless stays lossless, as libaom's "enable_chroma_deltaq && q" guard
+  if (q == 0) return;
+  const SequenceHeader *const seq = &cm->seq_params;
+  const int bd = (int)seq->bit_depth;
+  // AV2's AC step on AV1's 8-bit Q3 scale: AV2's tables carry QUANT_TABLE_BITS
+  // more fraction bits, and each bit of depth past 8 doubles the step.
+  const double step = (double)av2_ac_quant_QTX(q, 0, 0, seq->bit_depth) /
+                      (double)(1 << (QUANT_TABLE_BITS + (bd - 8)));
+  int q1 = 0;
+  while (q1 < 255 && iq_av1_ac_q8[q1 + 1] <= step) q1++;
+  if (q1 < 255 && step - iq_av1_ac_q8[q1] > iq_av1_ac_q8[q1 + 1] - step) q1++;
+  const double ac = iq_av1_ac_q8[q1];
+  const int dc = iq_ratio_to_delta(iq_av1_dc_q8[q1] / ac);
+  quant_params->y_dc_delta_q = dc;
+  if (av2_num_planes(cm) == 1) return;
+  int uv_dc = dc, uv_ac = 0;
+  if (seq->subsampling_x && seq->subsampling_y) {
+    const int x = clamp(q1 / 2 - 14, 0, 16);
+    uv_dc = iq_ratio_to_delta(iq_av1_dc_q8[AVMMAX(q1 - x, 0)] / ac);
+    uv_ac = iq_ratio_to_delta(iq_av1_ac_q8[AVMMAX(q1 - x, 0)] / ac);
+  } else if (seq->subsampling_x) {
+    uv_ac = iq_ratio_to_delta(
+        iq_av1_ac_q8[AVMMIN(q1 + AVMMIN(q1 / 2, 6), 255)] / ac);
+  } else {
+    uv_ac = iq_ratio_to_delta(
+        iq_av1_ac_q8[AVMMIN(q1 + AVMMIN(q1 / 2, 24), 255)] / ac);
+  }
+  quant_params->u_dc_delta_q = quant_params->v_dc_delta_q = uv_dc;
+  quant_params->u_ac_delta_q = quant_params->v_ac_delta_q = uv_ac;
+}

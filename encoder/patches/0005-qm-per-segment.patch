diff --avm
--- a/av2/encoder/aq_variance.c	2026-09-27 10:34:17
+++ b/av2/encoder/aq_variance.c	2026-09-27 14:02:06
@@ -13,6 +13,7 @@
 #include <math.h>
 #include <stdio.h>
 #include <stdlib.h>
+#include <string.h>
 
 #include "avm_ports/mem.h"
 
@@ -494,4 +495,64 @@
     qindex_delta = -base_qindex + 1;
   }
   return base_qindex + qindex_delta;
+}
+
+// Per-segment QM (qmseg): classify each unit by the jpegli field, write the
+// segment map, and give the textured segment its own QM set. Runs after
+// av2_set_quantizer, which resets the frame to a single QM set, and leaves
+// segmentation alone when another tool already owns it.
+void av2_qmseg_frame_setup(AV2_COMP *cpi) {
+  AV2_COMMON *const cm = &cpi->common;
+  const QuantizationCfg *const q_cfg = &cpi->oxcf.q_cfg;
+  CommonQuantParams *const qp = &cm->quant_params;
+  struct segmentation *const seg = &cm->seg;
+  if (!q_cfg->qmseg || !qp->using_qmatrix || !frame_is_intra_only(cm) ||
+      seg->enabled)
+    return;
+  av2_jpegli_mask_frame(cpi);
+  if (!cpi->jm_qf) return;
+  const int mi_rows = cm->mi_params.mi_rows, mi_cols = cm->mi_params.mi_cols;
+  const int step = q_cfg->qmseg_unit / MI_SIZE;  // unit in mi
+  const int nb = q_cfg->qmseg_unit >> 3;         // unit in 8x8 field blocks
+  const float thr = q_cfg->qmseg_thresh / 100.0f;
+  int textured = 0, units = 0;
+  float qmin = 1e9f, qmax = 0, qsum = 0;
+  for (int ur = 0; ur < mi_rows; ur += step) {
+    for (int uc = 0; uc < mi_cols; uc += step) {
+      const float q = jm_pool(cpi, (uc * MI_SIZE) >> 3, (ur * MI_SIZE) >> 3,
+                              nb, nb);
+      qmin = AVMMIN(qmin, q);
+      qmax = AVMMAX(qmax, q);
+      qsum += q;
+      const uint8_t id = q < thr;
+      textured += id;
+      ++units;
+      for (int r = ur; r < AVMMIN(ur + step, mi_rows); ++r)
+        memset(cpi->enc_seg.map + r * mi_cols + uc, id,
+               AVMMIN(step, mi_cols - uc));
+    }
+  }
+  if (getenv("AVM_QMSEG_DEBUG"))
+    fprintf(stderr,
+            "qmseg: %d of %d units textured (thresh %.2f, pooled qf "
+            "min %.3f mean %.3f max %.3f)\n",
+            textured, units, thr, qmin, qsum / AVMMAX(units, 1), qmax);
+  // One class covers the frame: no map to signal. A fully textured frame
+  // takes the textured level frame-wide; a fully smooth one keeps its own.
+  if (textured == 0 || textured == units) {
+    memset(cpi->enc_seg.map, 0, (size_t)mi_rows * mi_cols);
+    if (textured == units) qp->qm_y[0] = q_cfg->qmseg_level;
+    return;
+  }
+  av2_enable_segmentation(seg);
+  av2_clearall_segfeatures(seg);
+  av2_set_segdata(seg, 1, SEG_LVL_ALT_Q, 0);
+  av2_enable_segfeature(seg, 1, SEG_LVL_ALT_Q);
+  qp->pic_qm_num = 2;
+  qp->qm_index_bits = 1;
+  qp->qm_y[1] = q_cfg->qmseg_level;
+  qp->qm_u[1] = qp->qm_u[0];
+  qp->qm_v[1] = qp->qm_v[0];
+  memset(qp->qm_index, 0, sizeof(qp->qm_index));
+  qp->qm_index[1] = 1;
 }

diff --avm
--- a/av2/common/quant_common.c
+++ b/av2/common/quant_common.c
@@ -293,7 +293,11 @@
     // If iwt_matrix[i] <= 4, then 1024 / iwt_matrix[i] >= 256, which cannot be
     // stored in wt_matrix[i] without losing integer precision.
     assert(iwt_matrix[i] > 4);
-    wt_matrix[i] = 1024 / iwt_matrix[i];
+    // Rounded, as AVM's predefined weights are (all of them equal
+    // round(1024 / iwt)); truncating instead quantized a user matrix equal to
+    // a predefined one differently on 38% of entries. Encoder only: the
+    // decoder dequantizes with iwt (av2-tone patch 0012).
+    wt_matrix[i] = (1024 + iwt_matrix[i] / 2) / iwt_matrix[i];
   }
 }
 

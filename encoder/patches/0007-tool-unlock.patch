diff --avm
--- a/av2/encoder/speed_features.c	2026-09-26 21:29:57
+++ b/av2/encoder/speed_features.c	2026-10-14 14:50:10
@@ -1041,6 +1041,23 @@
   if (oxcf->mode == GOOD)
     set_good_speed_features_framesize_independent(cpi, sf, speed);
 
+  // tool-unlock (patches/0007): turn back on what the speed level switched
+  // off, one tool per bit, so each can be measured on its own.
+  const int unlock = oxcf->q_cfg.tool_unlock;
+  if (unlock & 2) {
+    sf->tx_sf.tx_type_search.skip_stx_search = 0;
+    sf->tx_sf.tx_type_search.skip_cctx_search = 0;
+  }
+  if (unlock & 4) sf->rd_sf.disable_tcq = 0;
+  if (unlock & 16) sf->lpf_sf.disable_lr_filter = 0;
+  if (unlock & 32) {
+    for (i = 0; i < TX_SIZES; i++) {
+      sf->intra_sf.intra_y_mode_mask[i] = INTRA_ALL;
+      sf->intra_sf.intra_uv_mode_mask[i] = UV_INTRA_ALL;
+    }
+  }
+  if (unlock & 64) sf->intra_sf.skip_intra_dip_search = false;
+
   if (!cpi->seq_params_locked) {
     cpi->common.seq_params.enable_restoration &= !sf->lpf_sf.disable_lr_filter;
 
@@ -1057,6 +1074,12 @@
     if (sf->rd_sf.disable_tcq) {
       cpi->common.seq_params.enable_tcq = TCQ_DISABLE;
       cpi->common.features.tcq_mode = TCQ_DISABLE;
+    }
+    if ((unlock & 8) &&
+        cpi->common.seq_params.enable_tcq == TCQ_DISABLE &&
+        !is_lossless_requested(&oxcf->rc_cfg)) {
+      cpi->common.seq_params.enable_parity_hiding =
+          oxcf->tool_cfg.enable_parity_hiding;
     }
   }
 

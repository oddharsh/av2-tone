 #define DEFAULT_E_MIDPOINT 10.0
+
+/* ---- jpegli masking field (deltaq-mode=4) ------------------------------
+ * Scalar port of google/jpegli lib/jpegli/adaptive_quantization.cc @031a0077.
+ * Luma is taken on jpegli's 0..255 scale whatever the stream's bit depth. */
+#define JM_INPUT_SCALING (1.0f / 255.0f)
+
+// RatioOfDerivativesOfCubicRootToSimpleGamma: moves a difference from the
+// cube-root response into butteraugli's log-gamma space.
+static float jm_ratio(float v, int invert) {
+  const float kSGmul = 226.0480446705883f;
+  const float kSGmul2 = 1.0f / 73.377132366608819f;
+  const float kInvLog2e = 0.6931471805599453f;
+  const float kSGRetMul = kSGmul2 * 18.6580932135f * kInvLog2e;
+  const float kSGVOffset = 7.14672470003f;
+  const float kEpsilon = 1e-2f;
+  const float kNumOffset = kEpsilon / JM_INPUT_SCALING / JM_INPUT_SCALING;
+  const float kNumMul = kSGRetMul * 3 * kSGmul;
+  const float kVOffset = (kSGVOffset * kInvLog2e + kEpsilon) / JM_INPUT_SCALING;
+  const float kDenMul =
+      kInvLog2e * kSGmul * JM_INPUT_SCALING * JM_INPUT_SCALING;
+  if (v < 0) v = 0;
+  const float v2 = v * v;
+  const float num = kNumMul * v2 + kNumOffset;
+  const float den = kDenMul * v * v2 + kVOffset;
+  return invert ? num / den : den / num;
+}
+
+static float jm_masking_sqrt(float v) {
+  return 0.25f * sqrtf(v * sqrtf(211.50759899638012f * 1e8f) + 28.0f);
+}
+
+static float jm_compute_mask(float out) {
+  const float kBase = -0.74174993f, kMul4 = 3.2353257320940401f;
+  const float kMul2 = 12.906028311180409f, kOffset2 = 305.04035728311436f;
+  const float kMul3 = 5.0220313103171232f, kOffset3 = 2.1925739705298404f;
+  const float kOffset4 = 0.25f * kOffset3, kMul0 = 0.74760422233706747f;
+  const float v1 = AVMMAX(out * kMul0, 1e-3f);
+  const float v2 = 1.0f / (v1 + kOffset2);
+  const float v3 = 1.0f / (v1 * v1 + kOffset3);
+  const float v4 = 1.0f / (v1 * v1 + kOffset4);
+  return kBase + kMul4 * v4 + kMul2 * v2 + kMul3 * v3;
+}
+
+static int jm_cmp_float(const void *a, const void *b) {
+  const float x = *(const float *)a, y = *(const float *)b;
+  return (x > y) - (x < y);
+}
+
+// The superblock's qf: the octile-th value of its 8x8 blocks, ascending, so a
+// high octile follows the most precision-hungry blocks.
+static float jm_pool(const AV2_COMP *cpi, int bx0, int by0, int nbw, int nbh) {
+  float vals[1024];
+  int n = 0;
+  for (int by = by0; by < AVMMIN(by0 + nbh, cpi->jm_bh); ++by)
+    for (int bx = bx0; bx < AVMMIN(bx0 + nbw, cpi->jm_bw); ++bx)
+      if (n < 1024) vals[n++] = cpi->jm_qf[by * cpi->jm_bw + bx];
+  if (n == 0) return 1.0f;
+  qsort(vals, n, sizeof(vals[0]), jm_cmp_float);
+  return vals[clamp(cpi->oxcf.q_cfg.jm_octile * n / 8 - 1, 0, n - 1)];
+}
+
+void av2_jpegli_mask_frame(AV2_COMP *cpi) {
+  const AV2_COMMON *const cm = &cpi->common;
+  const QuantizationCfg *const q_cfg = &cpi->oxcf.q_cfg;
+  const YV12_BUFFER_CONFIG *const src = cpi->source;
+  const int w = src->y_crop_width, h = src->y_crop_height;
+  const int stride = src->y_stride;
+  const float scale = 255.0f / (float)((1 << cm->seq_params.bit_depth) - 1);
+  const int bw = (w + 7) >> 3, bh = (h + 7) >> 3;
+  const int W = bw * 8, H = bh * 8;  // padded to whole 8x8 blocks
+  const int pw = bw * 2, ph = bh * 2;  // the 4x4 pre-erosion grid
+  float *pix = avm_malloc(sizeof(*pix) * W * H);
+  float *pre = avm_malloc(sizeof(*pre) * pw * ph);
+  float *ero = avm_malloc(sizeof(*ero) * pw * ph);
+  if (!pix || !pre || !ero) goto done;
+  for (int y = 0; y < H; ++y)
+    for (int x = 0; x < W; ++x)
+      pix[y * W + x] =
+          scale * src->y_buffer[AVMMIN(y, h - 1) * stride + AVMMIN(x, w - 1)];
+#define JM_P(xx, yy) pix[clamp((yy), 0, H - 1) * W + clamp((xx), 0, W - 1)]
+  // ComputePreErosion: gamma-weighted Laplacian, clipped, MaskingSqrt, 4x4 pool
+  for (int py = 0; py < ph; ++py) {
+    for (int px = 0; px < pw; ++px) {
+      float sum = 0;
+      for (int dy = 0; dy < 4; ++dy) {
+        for (int dx = 0; dx < 4; ++dx) {
+          const int x = px * 4 + dx, y = py * 4 + dy;
+          const float in = JM_P(x, y);
+          const float base = 0.25f * (JM_P(x - 1, y) + JM_P(x + 1, y) +
+                                      JM_P(x, y - 1) + JM_P(x, y + 1));
+          const float g = jm_ratio(in + 0.019f * 255.0f, 0);
+          float d = g * (in - base);
+          d = AVMMIN(d * d, 0.2f);
+          sum += jm_masking_sqrt(d);
+        }
+      }
+      pre[py * pw + px] = 0.25f * sum;
+    }
+  }
+  // FuzzyErosion: weighted sum of the 4 smallest in each 3x3 neighbourhood
+  for (int py = 0; py < ph; ++py) {
+    for (int px = 0; px < pw; ++px) {
+      float m[4] = { 1e30f, 1e30f, 1e30f, 1e30f };
+      for (int dy = -1; dy <= 1; ++dy) {
+        for (int dx = -1; dx <= 1; ++dx) {
+          float v = pre[clamp(py + dy, 0, ph - 1) * pw + clamp(px + dx, 0, pw - 1)];
+          for (int k = 0; k < 4; ++k)
+            if (v < m[k]) { const float t = m[k]; m[k] = v; v = t; }
+        }
+      }
+      ero[py * pw + px] =
+          0.125f * m[0] + 0.075f * m[1] + 0.06f * m[2] + 0.05f * m[3];
+    }
+  }
+  if (!cpi->jm_qf || cpi->jm_bw != bw || cpi->jm_bh != bh) {
+    avm_free(cpi->jm_qf);
+    cpi->jm_qf = avm_malloc(sizeof(*cpi->jm_qf) * bw * bh);
+    cpi->jm_bw = bw;
+    cpi->jm_bh = bh;
+    if (!cpi->jm_qf) goto done;
+  }
+  // PerBlockModulations. jpegli dampens by its quant table's AC(1) entry; here
+  // that is jm-dampen, since an AV2 qindex has no JPEG quality to read off.
+  const float dampen = q_cfg->jm_dampen / 100.0f;
+  const float mul = 0.841f * dampen;
+  const float add = (1.0f - dampen) * 0.48f * 0.841f;
+  for (int by = 0; by < bh; ++by) {
+    for (int bx = 0; bx < bw; ++bx) {
+      const int e0 = (by * 2) * pw + bx * 2;
+      float out = jm_compute_mask(ero[e0] + ero[e0 + 1] + ero[e0 + pw] +
+                                  ero[e0 + pw + 1]);
+      float hf = 0, gr = 0;
+      for (int dy = 0; dy < 8; ++dy) {
+        for (int dx = 0; dx < 8; ++dx) {
+          const int x = bx * 8 + dx, y = by * 8 + dy;
+          const float p = JM_P(x, y);
+          if (dx < 7) hf += fabsf(p - JM_P(x + 1, y));
+          if (dy < 7) hf += fabsf(p - JM_P(x, y + 1));
+          gr += jm_ratio(p + 0.16f * 255.0f, 1);
+        }
+      }
+      out += hf * (-2.0052193233688884f * JM_INPUT_SCALING / 112.0f);
+      out += (-0.15526878023684174f * 0.6931471805599453f) *
+             log2f(gr * (JM_INPUT_SCALING / 64.0f));
+      cpi->jm_qf[by * bw + bx] = expf(out) * mul + add;
+    }
+  }
+#undef JM_P
+  {
+    // the frame reference: geometric mean of the pooled superblock values
+    const int sbpx = mi_size_wide[cm->sb_size] * MI_SIZE;
+    const int nb = AVMMAX(1, sbpx >> 3);
+    double acc = 0;
+    int n = 0;
+    for (int by = 0; by < bh; by += nb)
+      for (int bx = 0; bx < bw; bx += nb) {
+        acc += log(AVMMAX(jm_pool(cpi, bx, by, nb, nb), 1e-6f));
+        ++n;
+      }
+    cpi->jm_ref_log = n ? acc / n : 0.0;
+  }
+done:
+  avm_free(pix);
+  avm_free(pre);
+  avm_free(ero);
+}
+
+int av2_get_sbq_jpegli_mask(const AV2_COMP *cpi, int mi_row, int mi_col,
+                            BLOCK_SIZE sb_size) {
+  const AV2_COMMON *const cm = &cpi->common;
+  const QuantizationCfg *const q_cfg = &cpi->oxcf.q_cfg;
+  const int base_qindex = cm->quant_params.base_qindex;
+  if (base_qindex <= 0 || !cpi->jm_qf) return base_qindex;
+  const int nb = AVMMAX(1, (mi_size_wide[sb_size] * MI_SIZE) >> 3);
+  const float pooled = jm_pool(cpi, (mi_col * MI_SIZE) >> 3,
+                               (mi_row * MI_SIZE) >> 3, nb, nb);
+  const double ratio = exp((q_cfg->jm_strength / 10.0) *
+                           (log(AVMMAX(pooled, 1e-6f)) - cpi->jm_ref_log));
+  const avm_bit_depth_t bd = cm->seq_params.bit_depth;
+  const int qmax = (bd == AVM_BITS_8    ? QINDEX_RANGE_8_BITS
+                    : bd == AVM_BITS_10 ? QINDEX_RANGE_10_BITS
+                                        : QINDEX_RANGE) -
+                   1;
+  const double target_q = av2_convert_qindex_to_q(base_qindex, bd) / ratio;
+  int target = av2_find_qindex(target_q, bd, MINQ, qmax);
+  target = clamp(target, base_qindex - q_cfg->jm_max_delta,
+                 base_qindex + q_cfg->jm_max_delta);
+  if (getenv("AVM_JM_DEBUG"))
+    fprintf(stderr, "jm sb mi(%d,%d) pooled %.4f ref %.4f ratio %.3f base %d target %d\n", mi_row, mi_col, pooled, exp(cpi->jm_ref_log), ratio, base_qindex, target);
+  return AVMMAX(target, 1);
+}
 

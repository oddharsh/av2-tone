+// lambda-map / field-dump (patches/0009), checked before the frame starts:
+// an error raised mid-frame crashes AVM's multithreaded teardown, so a bad map
+// is refused here, by the API call, instead.
+static avm_codec_err_t validate_lambda_map(avm_codec_alg_priv_t *ctx,
+                                           const avm_image_t *img) {
+  const struct av2_extracfg *const cfg = &ctx->extra_cfg;
+  if (!cfg->lambda_map && !cfg->field_dump) return AVM_CODEC_OK;
+  if (cfg->tuning != AVM_TUNE_SSIM)
+    ERROR("lambda-map and field-dump need tune=ssim");
+  if (!cfg->lambda_map) return AVM_CODEC_OK;
+  // The 16x16 grid av2_set_mb_ssim_rdmult_scaling walks: 4x4 mi units over
+  // the frame padded to 8 pixels.
+  const int cols = ((((int)img->d_w + 7) & ~7) / 4 + 3) / 4;
+  const int rows = ((((int)img->d_h + 7) & ~7) / 4 + 3) / 4;
+  FILE *f = fopen(cfg->lambda_map, "r");
+  if (!f) ERROR("lambda-map: cannot open the file");
+  int w = 0, h = 0, ok = fscanf(f, " lambda %d %d", &w, &h) == 2;
+  ok = ok && w == cols && h == rows;
+  for (int i = 0; ok && i < cols * rows; ++i) {
+    double v = 0.0;
+    ok = fscanf(f, "%lf", &v) == 1 && v > 0.0;
+  }
+  fclose(f);
+  if (!ok)
+    ERROR("lambda-map: not a 'lambda <cols> <rows>' map of positive scales "
+          "for this frame's 16x16 grid");
+  return AVM_CODEC_OK;
+}

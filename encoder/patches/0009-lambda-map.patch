+
+  // lambda-map / field-dump (patches/0009). The dump comes first, so it
+  // always holds tune=ssim's own scales; a map then replaces them.
+  const QuantizationCfg *const q_cfg = &cpi->oxcf.q_cfg;
+  if (q_cfg->field_dump) {
+    FILE *f = fopen(q_cfg->field_dump, "w");
+    if (!f)
+      avm_internal_error(&cpi->common.error, AVM_CODEC_INVALID_PARAM,
+                         "field-dump: cannot write %s", q_cfg->field_dump);
+    fprintf(f, "ssim %d %d\n", num_cols, num_rows);
+    for (int i = 0; i < num_rows * num_cols; ++i)
+      fprintf(f, "%.9g%c", cpi->ssim_rdmult_scaling_factors[i],
+              (i + 1) % num_cols ? ' ' : '\n');
+    av2_jpegli_mask_frame(cpi);
+    if (cpi->jm_qf) {
+      fprintf(f, "jpegli %d %d\n", cpi->jm_bw, cpi->jm_bh);
+      for (int i = 0; i < cpi->jm_bw * cpi->jm_bh; ++i)
+        fprintf(f, "%.9g%c", cpi->jm_qf[i], (i + 1) % cpi->jm_bw ? ' ' : '\n');
+    }
+    fclose(f);
+  }
+  if (q_cfg->lambda_map) {
+    // "lambda <cols> <rows>" then one positive scale per 16x16 luma block,
+    // row-major. A map for another grid is an error, never a fallback.
+    FILE *f = fopen(q_cfg->lambda_map, "r");
+    int cols = 0, rows = 0;
+    if (!f || fscanf(f, " lambda %d %d", &cols, &rows) != 2 ||
+        cols != num_cols || rows != num_rows) {
+      if (f) fclose(f);
+      avm_internal_error(&cpi->common.error, AVM_CODEC_INVALID_PARAM,
+                         "lambda-map: %s is not a %dx%d map",
+                         q_cfg->lambda_map, num_cols, num_rows);
+    }
+    double map_log_sum = 0.0;
+    for (int i = 0; i < num_rows * num_cols; ++i) {
+      double v = 0.0;
+      if (fscanf(f, "%lf", &v) != 1 || !(v > 0.0)) {
+        fclose(f);
+        avm_internal_error(&cpi->common.error, AVM_CODEC_INVALID_PARAM,
+                           "lambda-map: %s: entry %d is missing or not "
+                           "positive", q_cfg->lambda_map, i);
+      }
+      cpi->ssim_rdmult_scaling_factors[i] = v;
+      map_log_sum += log(v);
+    }
+    fclose(f);
+    // Keep the frame's mean lambda where tune=ssim keeps it: the map moves
+    // rate between blocks, not the frame's overall rate.
+    map_log_sum = exp(map_log_sum / (double)(num_rows * num_cols));
+    for (int i = 0; i < num_rows * num_cols; ++i)
+      cpi->ssim_rdmult_scaling_factors[i] /= map_log_sum;
+  }

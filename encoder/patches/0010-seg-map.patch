+// seg-map (patches/0010), checked before the frame for the same reason.
+static avm_codec_err_t validate_seg_map(avm_codec_alg_priv_t *ctx,
+                                        const avm_image_t *img) {
+  static char err[200];
+  const struct av2_extracfg *const cfg = &ctx->extra_cfg;
+  if (!cfg->seg_map) return AVM_CODEC_OK;
+  if (cfg->qmseg) ERROR("seg-map replaces qmseg; drop qmseg=1");
+  if (cfg->aq_mode != NO_AQ) ERROR("seg-map needs aq-mode=0");
+  SegMap m;
+  const int bad = av2_segmap_read(
+      cfg->seg_map, ((int)img->d_w + 7) >> 3, ((int)img->d_h + 7) >> 3,
+      cfg->enable_ext_seg ? MAX_SEGMENTS : MAX_SEGMENTS_8, &m, err,
+      sizeof(err));
+  int wants_qm = 0;
+  for (int s = 0; !bad && s < MAX_SEGMENTS; ++s)
+    wants_qm |= m.used[s] && m.qm[s] >= 0;
+  av2_segmap_free(&m);
+  if (bad) ERROR(err);
+  if (wants_qm && !cfg->enable_qm)
+    ERROR("seg-map: a QM level needs enable-qm=1");
+  return AVM_CODEC_OK;
+}

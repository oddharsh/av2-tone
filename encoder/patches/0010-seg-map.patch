+// seg-map (patches/0010). The file:
+//   segmap <cols> <rows>          the 8x8 luma block grid, ceil(w/8) x ceil(h/8)
+//   <cols * rows segment ids>     row-major
+//   seg <id> <qindex delta> <qm>  one line per segment; qm is a luma QM level
+//                                 0..15, or -1 for the frame's own
+// A block takes the smallest id under it, so number segments finest first.
+// The frame gets at most 4 QM sets (AV2's limit): its own plus 3 levels.
+int av2_segmap_read(const char *path, int cols, int rows, int max_segs,
+                    SegMap *m, char *err, size_t err_len) {
+  memset(m, 0, sizeof(*m));
+  FILE *f = fopen(path, "r");
+  if (!f) {
+    snprintf(err, err_len, "seg-map: cannot open %s", path);
+    return -1;
+  }
+  int ok = fscanf(f, " segmap %d %d", &m->cols, &m->rows) == 2;
+  if (!ok || m->cols != cols || m->rows != rows) {
+    snprintf(err, err_len, "seg-map: not a 'segmap %d %d' grid", cols, rows);
+    fclose(f);
+    return -1;
+  }
+  m->ids = (uint8_t *)avm_malloc((size_t)cols * rows);
+  int in_map[MAX_SEGMENTS] = { 0 };
+  for (int i = 0; ok && i < cols * rows; ++i) {
+    int id = -1;
+    ok = m->ids && fscanf(f, "%d", &id) == 1 && id >= 0 && id < max_segs;
+    if (ok) m->ids[i] = (uint8_t)id, in_map[id] = 1;
+  }
+  if (!ok) {
+    snprintf(err, err_len,
+             "seg-map: the grid needs %d ids from 0 to %d (8 and up need "
+             "enable-ext-seg=1)",
+             cols * rows, max_segs - 1);
+    fclose(f);
+    return -1;
+  }
+  int id, dq, qm, levels[MAX_SEGMENTS], nlevels = 0;
+  while (fscanf(f, " seg %d %d %d", &id, &dq, &qm) == 3) {
+    if (id < 0 || id >= max_segs || m->used[id] || dq < -MAXQ || dq > MAXQ ||
+        qm < -1 || qm >= NUM_QM_LEVELS) {
+      snprintf(err, err_len,
+               "seg-map: bad or repeated line 'seg %d %d %d' (ids 0..%d, "
+               "deltas within +-%d, qm -1..%d)",
+               id, dq, qm, max_segs - 1, MAXQ, NUM_QM_LEVELS - 1);
+      fclose(f);
+      return -1;
+    }
+    m->used[id] = 1, m->qdelta[id] = dq, m->qm[id] = qm;
+    int seen = qm < 0;
+    for (int k = 0; k < nlevels; ++k) seen |= levels[k] == qm;
+    if (!seen) levels[nlevels++] = qm;
+  }
+  ok = feof(f) || (fscanf(f, " "), feof(f));
+  fclose(f);
+  if (!ok) {
+    snprintf(err, err_len, "seg-map: unreadable text after the seg lines");
+    return -1;
+  }
+  for (int s = 0; s < max_segs; ++s) {
+    if (in_map[s] && !m->used[s]) {
+      snprintf(err, err_len, "seg-map: segment %d is in the grid but has no "
+               "seg line", s);
+      return -1;
+    }
+  }
+  if (nlevels > 3) {
+    snprintf(err, err_len, "seg-map: %d QM levels besides the frame's own; "
+             "AV2 allows 3", nlevels);
+    return -1;
+  }
+  return 0;
+}
+
+void av2_segmap_free(SegMap *m) {
+  avm_free(m->ids);
+  m->ids = NULL;
+}
+
+// Runs where qmseg does (after av2_set_quantizer), and in its place: the map,
+// read from the file, decides every block's segment.
+void av2_segmap_frame_setup(AV2_COMP *cpi) {
+  AV2_COMMON *const cm = &cpi->common;
+  const char *const path = cpi->oxcf.q_cfg.seg_map;
+  if (!path || !frame_is_intra_only(cm)) return;
+  struct segmentation *const seg = &cm->seg;
+  CommonQuantParams *const qp = &cm->quant_params;
+  const int ext = cm->seq_params.enable_ext_seg;
+  const int cols = (cm->width + 7) >> 3, rows = (cm->height + 7) >> 3;
+  SegMap m;
+  char err[200];
+  if (av2_segmap_read(path, cols, rows, ext ? MAX_SEGMENTS : MAX_SEGMENTS_8,
+                      &m, err, sizeof(err))) {
+    av2_segmap_free(&m);
+    avm_internal_error(&cm->error, AVM_CODEC_INVALID_PARAM, "%s", err);
+  }
+  int top = 0, nsets = 1;
+  for (int s = 0; s < MAX_SEGMENTS; ++s)
+    if (m.used[s]) top = s;
+  // One segment that changes nothing is no map, as qmseg's one-class case.
+  if (top == 0 && m.qdelta[0] == 0 && m.qm[0] < 0) {
+    av2_segmap_free(&m);
+    return;
+  }
+  const int mi_rows = cm->mi_params.mi_rows, mi_cols = cm->mi_params.mi_cols;
+  for (int r = 0; r < mi_rows; ++r)
+    for (int c = 0; c < mi_cols; ++c)
+      cpi->enc_seg.map[r * mi_cols + c] =
+          m.ids[AVMMIN(r >> 1, rows - 1) * cols + AVMMIN(c >> 1, cols - 1)];
+  av2_enable_segmentation(seg);
+  av2_clearall_segfeatures(seg);
+  seg->enable_ext_seg = ext;
+  // ALT_Q goes on where the offset isn't 0, and on the highest listed id
+  // whatever its offset: AVM clamps ids above the last segment with a
+  // feature, so without it a QM-only top segment would fold into a lower one.
+  // (This is also what qmseg writes, so a map of qmseg's own split gives
+  // qmseg's bytes.)
+  if (qp->using_qmatrix) memset(qp->qm_index, 0, sizeof(qp->qm_index));
+  for (int s = 0; s < MAX_SEGMENTS; ++s) {
+    if (!m.used[s]) continue;
+    if (m.qdelta[s] != 0 || s == top) {
+      av2_set_segdata(seg, s, SEG_LVL_ALT_Q, m.qdelta[s]);
+      av2_enable_segfeature(seg, s, SEG_LVL_ALT_Q);
+    }
+    if (!qp->using_qmatrix || m.qm[s] < 0) continue;
+    int set = 1;
+    while (set < nsets && qp->qm_y[set] != m.qm[s]) ++set;
+    if (set == nsets) {
+      qp->qm_y[set] = m.qm[s];
+      qp->qm_u[set] = qp->qm_u[0];
+      qp->qm_v[set] = qp->qm_v[0];
+      ++nsets;
+    }
+    qp->qm_index[s] = set;
+  }
+  if (qp->using_qmatrix) {
+    qp->pic_qm_num = nsets;
+    qp->qm_index_bits = avm_ceil_log2(nsets);
+  }
+  av2_segmap_free(&m);
+}

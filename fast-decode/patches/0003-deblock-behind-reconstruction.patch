+/*! \brief An unfiltered copy of the frame being decoded, for IntraBC.
+ *
+ * When in-loop filters run behind reconstruction (av2/decoder/lf_pipeline.c),
+ * superblock rows two or more above the current one may already be filtered,
+ * yet IntraBC must predict from unfiltered pixels. Each finished row is copied
+ * here before any filter touches it, and IntraBC reads that reach those rows
+ * are served from the copy.
+ */
+typedef struct IbcShadow {
+  /*! Plane base pointers of the frame (buf_2d.buf0) */
+  const uint16_t *live[MAX_MB_PLANE];
+  /*! Offset from a frame pixel to the same pixel of the copy, per plane */
+  ptrdiff_t delta[MAX_MB_PLANE];
+  /*! log2 of the superblock height in luma pixels */
+  int sb_size_log2;
+  /*! Blocks until superblock rows first..last of a tile column are copied */
+  void (*wait)(const struct IbcShadow *s, int first, int last, int tile_col);
+} IbcShadow;
+
 /*! \brief Variables related to current coding block.
  *
  * This is a common set of variables used by both encoder and decoder.
@@ -2219,6 +2238,12 @@
   struct avm_internal_error_info *error_info;
 
   /*!
+   * Unfiltered copy for IntraBC reads above the previous superblock row, or
+   * NULL when the frame is filtered after decoding.
+   */
+  const IbcShadow *ibc_shadow;
+
+  /*!
    * Same as cm->global_motion.
    */
   const WarpedMotionParams *global_motion;
@@ -2325,6 +2350,33 @@
   /*! \brief Flag to indicate whether reduced transform partition mode is on */
   int reduced_tx_part_set;
 } MACROBLOCKD;
+
+/*!\brief The offset that moves an IntraBC read into the unfiltered copy.
+ *
+ * While superblock row r decodes, no filter has touched rows r-1 or r, so a
+ * read that starts in either stays on the frame (offset 0). A read that starts
+ * higher goes to the copy, after waiting for the rows it covers to land there.
+ * A block is never taller than a superblock, so such a read ends by row r-1.
+ * buf0 is the plane's base pointer, top_y and bottom_y the first and last
+ * plane rows read, mi_y the block's luma row.
+ */
+static INLINE ptrdiff_t av2_ibc_shadow_delta(const IbcShadow *s,
+                                             const uint16_t *buf0, int top_y,
+                                             int bottom_y, int mi_y, int ss_y,
+                                             int tile_col) {
+  if (!s) return 0;
+  const int cur = mi_y >> s->sb_size_log2;
+  const int first = AVMMAX((top_y << ss_y) >> s->sb_size_log2, 0);
+  if (first >= cur - 1) return 0;
+  const int last = AVMMIN((bottom_y << ss_y) >> s->sb_size_log2, cur - 1);
+  for (int p = 0; p < MAX_MB_PLANE; p++) {
+    if (buf0 == s->live[p]) {
+      s->wait(s, first, last, tile_col);
+      return s->delta[p];
+    }
+  }
+  return 0;
+}
 

 av2/common/arm/gdf_block_neon.c | 230 ++++++++++++++++++++++++++++++++
 av2/common/av2_rtcd_defs.pl     |   2 +-
 3 files changed, 232 insertions(+), 1 deletion(-)
 create mode 100644 av2/common/arm/gdf_block_neon.c

diff --git a/av2/av2.cmake b/av2/av2.cmake
index 2738bda..c8875e7 100644
--- a/av2/av2.cmake
+++ b/av2/av2.cmake
@@ -440,6 +440,7 @@ list(
   "${AVM_ROOT}/av2/common/arm/convolve_neon.c"
   "${AVM_ROOT}/av2/common/arm/convolve_neon.h"
   "${AVM_ROOT}/av2/common/arm/reconinter_neon.c"
